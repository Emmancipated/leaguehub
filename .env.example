# LeagueHub environment variables (template).
# Copy to .env and fill in real values before running locally.

# PostgreSQL connection string (matches docker-compose postgres on port 5433).
DATABASE_URL="postgresql://leaguehub:leaguehub@127.0.0.1:5433/leaguehub"

# Secret used to sign the `leaguehub_session` JWT cookie (jose HS256).
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=


# export REMOTE_DATABASE_URL="postgres://67f4e14e93a956291a6539da3dd8d28178e3ceca3686fd41daf6b22726d56965:sk_GH0R4O6W1ZFFscPq60dNG@db.prisma.io:5432/postgres?sslmode=require"
# DATABASE_URL="$REMOTE_DATABASE_URL" npx prisma db push
# DATABASE_URL="$REMOTE_DATABASE_URL" npx prisma db seed
# unset REMOTE_DATABASE_URL